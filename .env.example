# Ye file copy karke naam ".env" rakhein aur values bharein
# (server.js / database.js in hi variables ko process.env se padhte hain)

# ===== REQUIRED — MongoDB (iske bina server start hi nahi hoga) =====
# Local Mongo (agar apne PC pe MongoDB install kiya hai):
MONGODB_URI=mongodb://localhost:27017/designmakers
# Pehli baar khali/nayi database ke saath start karne ke liye "true" rakhein.
# Isse code apna built-in sample data (products etc.) khud seed kar dega.
ALLOW_NEW_DATABASE=true

# ===== SECURITY — PRODUCTION ME YE SAB ZAROORI HAIN =====
# NODE_ENV=production rakhne par (Render pe apne aap ON hota hai) server in teeno ke bina START HI NAHI hoga:
# JWT_SECRET (32+ chars), ADMIN1_PASSWORD (default nahi), PII_ENCRYPTION_KEY (64 hex).
# Production me HTTPS zabardasti lagta hai aur cookies Secure ban jaati hain.
NODE_ENV=production
# Login idle timeout (minutes). Admin/seller default 30. Customers default 1440 (24h) — 30 karna ho to 30 likhein.
ADMIN_IDLE_MINUTES=30
SELLER_IDLE_MINUTES=30
CUSTOMER_IDLE_MINUTES=1440
# Naya CSP test karna ho (block kiye bina sirf report) to true rakhein:
# CSP_REPORT_ONLY=true
# Login tokens sign karne ke liye — koi bhi lamba random string
JWT_SECRET=

# Seller Aadhaar/PAN/bank details encrypt karne ke liye (64-char hex).
# Generate karne ka command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# Admin/"boss" login
ADMIN1_USERNAME=
ADMIN1_PASSWORD=

# ===== OPTIONAL — Google Sign-In =====
GOOGLE_CLIENT_ID=

# ===== OPTIONAL — Email (na ho to bhi server chalega, bas auto-email off rahega) =====
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFY_EMAIL=

# ===== OPTIONAL — Site URL (email links, redirects ke liye) =====
SITE_URL=
BASE_URL=
PUBLIC_BASE_URL=

# ===== OPTIONAL =====
PORT=3000

# Sirf emergency me: sub-admin designation checks band karne ke liye (normal me mat rakhein)
# ADMIN_AREA_ENFORCEMENT=off
